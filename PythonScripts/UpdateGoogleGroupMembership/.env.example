##########################################################
# UpdateAdminGoogleGroup.py

# -------------------------
# Postgres
# -------------------------
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional: path to a SQL file containing the query
# If omitted, the default query in the script is used
SQL_QUERY_FILE=./query.sql

# -------------------------
# Google Workspace / Admin SDK
# -------------------------
# Path to the downloaded service account JSON key
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# Admin user to impersonate (must be a Workspace admin)
GOOGLE_IMPERSONATE_USER=admin@example.com

# Google Group to sync
GOOGLE_GROUP_EMAIL=target-group@example.com

# -------------------------
# Behavior
# -------------------------
# true = apply changes
# false = dry run (recommended first)
APPLY_CHANGES=false

# true = debug logging
VERBOSE=false
