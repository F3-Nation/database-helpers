# Copy this file to `.env` and fill in your values.
#   cp .env.sample .env
# The app auto-loads `.env` on startup (see gcp_iam.py). `.env` is gitignored.

# Scope to inspect/manage. Use an organization, folder, or project:
#   organizations/1234567890   |   folders/1234567890   |   projects/my-project-id
GCP_SCOPE=organizations/803404482088

# Project whose quota is billed for Cloud Asset Inventory API calls.
GCP_QUOTA_PROJECT=f3-workspace

# Optional. Only needed for custom org-level roles if GCP_SCOPE is not an org.
# GCP_ORG_ID=803404482088
