# Postgres
PG_HOST=your.database.host
PG_PORT=5432
PG_DBNAME=f3_nation
PG_USER=your_username
PG_PASSWORD=your_password

# GCS destination bucket
NEW_BUCKET_NAME=f3-public-images

# Destination path patterns
EVENT_INSTANCE_PREFIX=event_instance_images/
ORG_LOGO_PREFIX=org-logos/

# Extension behavior
# source => keep extension found in source URL; otherwise use DEFAULT_IMAGE_EXT
EVENT_FORCE_EXT=source
ORG_FORCE_EXT=source
DEFAULT_IMAGE_EXT=jpg
