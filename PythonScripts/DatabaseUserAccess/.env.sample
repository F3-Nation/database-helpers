# Copy this file to `.env` and edit if you want different startup defaults.
#   cp .env.sample .env
# `.env` is gitignored. The app can switch service/database at runtime regardless.

# Which libpq service (from ~/.pg_service.conf) to select on startup.
PG_SERVICE=prod

# Which database to select on startup.
PG_DBNAME=f3_prod

# Optional: point at a non-default libpq service file.
# PGSERVICEFILE=/home/you/.pg_service.conf
